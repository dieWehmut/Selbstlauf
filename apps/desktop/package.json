{
  "name": "@ai-cli-bypass/desktop",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build --silent && electron .",
    "test": "npm run build --silent && node --test --test-concurrency=1 dist/test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "package:dir": "electron-builder --dir --config electron-builder.config.mjs",
    "package:win": "electron-builder --win --config electron-builder.config.mjs"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "^26.0.12"
  },
  "description": "Selbstlauf desktop app: hosts the bundled continuation watchdog and console.",
  "author": "Selbstlauf contributors"
}
