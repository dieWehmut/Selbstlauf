{
  "name": "@ai-cli-bypass/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "build:android": "npm run sync && cd android && ./gradlew :app:assembleDebug",
    "test:android": "npm run sync && cd android && ./gradlew :app:connectedDebugAndroidTest"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vue": "3.5.18"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.5"
  }
}
